# 将此示例放入 Nginx 的 http 上下文。部署前确认端口、DNS 和证书路径。
# 如 HOST_PORT 不是 3101，修改以下 upstream 地址。
limit_req_zone $binary_remote_addr zone=lbsc_requests:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=lbsc_connections:10m;

server {
    listen 80;
    server_name lbsc.maishikeji.com.cn albsc.maishikeji.com.cn;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name lbsc.maishikeji.com.cn;
    ssl_certificate /etc/letsencrypt/live/lbsc.maishikeji.com.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lbsc.maishikeji.com.cn/privkey.pem;
    client_max_body_size 8m;
    client_header_timeout 15s;
    client_body_timeout 15s;
    limit_req zone=lbsc_requests burst=40 nodelay;
    limit_req_status 429;
    limit_conn lbsc_connections 30;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    server_name albsc.maishikeji.com.cn;
    ssl_certificate /etc/letsencrypt/live/albsc.maishikeji.com.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/albsc.maishikeji.com.cn/privkey.pem;
    client_max_body_size 8m;
    client_header_timeout 15s;
    client_body_timeout 15s;
    limit_req zone=lbsc_requests burst=40 nodelay;
    limit_req_status 429;
    limit_conn lbsc_connections 30;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    location = / {
        proxy_pass http://127.0.0.1:3101/admin;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location / {
        proxy_pass http://127.0.0.1:3101;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
